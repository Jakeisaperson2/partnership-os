<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Partnership Opportunity field to the project form -->
    <record id="project_view_form_partnership" model="ir.ui.view">
        <field name="name">project.project.view.form.partnership</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!-- Insert the opportunity link in the Settings tab -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="opportunity_id"
                       string="Partnership Opportunity"
                       options="{'no_create': True}"
                       domain="[('type', '=', 'opportunity')]"/>
            </xpath>
        </field>
    </record>

    <!-- Add Partnership Opportunity column to the project list view -->
    <record id="project_view_list_partnership" model="ir.ui.view">
        <field name="name">project.project.view.list.partnership</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="opportunity_id" string="Partnership" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
